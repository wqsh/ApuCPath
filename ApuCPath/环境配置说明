linux打包

conda install -c conda-forge gdal pyvips openslide openslide-python

pip install -r \ApuCellGlobal\requirements.txt

pyinstaller ApuCPath.py -F --hidden-import imageio --collect-all imageio --hidden-import=osgeo._gdal --collect-all osgeo --add-binary "${CONDA_PREFIX}/lib/libnsl.so*:." --add-binary "ApuCellGlobal/DLL/libopenslide.so.1:openslide_bin" --add-data "${CONDA_PREFIX}/lib/python*/site-packages/PyQt5/Qt5/plugins:PyQt5/Qt/plugins" --add-binary "${CONDA_PREFIX}/lib/python*/site-packages/PyQt5/Qt5/lib/*.so*:."

cp -r ApuCellGlobal/DLL dist/
cp -r ${CONDA_PREFIX}/lib/python*/site-packages/PyQt5/Qt5/plugins/platforms dist/