QMainWindow {
    font-family: "Segoe UI", "Arial", "sans-serif";
    font-size: 14px;
    color: #303133;
}

QMainWindow QToolButton {
	border: none;
	background-color: none;
}

QMainWindow QToolButton:checked {
	background-color: #D9D9D9;
	border: 1px solid #999999;
}

QMainWindow QTableWidget {
    background-color: #ECF5FF;
    gridline-color: #A0CFFF;
    selection-background-color: #409EFF;
}
QMainWindow QTableWidget > QTableCornerButton::section {
    background-color: #ECF5FF;
}
QMainWindow QTableWidget > QHeaderView {
    background-color: #ECF5FF;
}
QMainWindow QTableWidget > QHeaderView::section {
    background-color: #C6E2FF;
    padding: 5px;
    border: 1px solid #A0CFFF;
    font-weight: bold;
}

QMainWindow QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #DCDFE6;
    border-radius: 2px;
    color: #303133;
    font-size: 14px;
    height: 20px;
    padding: 2px;
}
QMainWindow QSpinBox::up-button, QSpinBox::down-button {
    background-color: #F0F2F5;
    border: none;
    width: 16px;
    height: 12px;
}
QMainWindow QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #E6E8EB;
}
QMainWindow QSpinBox::up-arrow {
    image: url("resources/icons/up.svg");
    width: 14px;
    height: 7px;
}
QMainWindow QSpinBox::down-arrow {
    image: url("resources/icons/down.svg");
    width: 14px;
    height: 7px;
}

QMainWindow QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #DCDFE6;
    padding: 2px 10px;
    border-radius: 2px;
    color: #303133;
    font-size: 14px;
}
QMainWindow QLineEdit:hover {
    border: 1px solid #409EFF;
    background-color: #ECF5FF;
}
QMainWindow QLineEdit:focus {
    border: 1px solid #409EFF;
    background-color: #ECF5FF;
}
QMainWindow QLineEdit::selection {
    background: transparent;
    color: #303133;
}

QMainWindow QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #DCDFE6;
    border-radius: 2px;
    color: #303133;
    font-size: 14px;
    font-weight: bold;
    outline: none;
}

QMainWindow QPushButton:hover {
    background-color: #ECF5FF;
    border: 1px solid #409EFF;
}
QMainWindow QPushButton:pressed {
    background-color: #79BBFF;
    border: 1px solid #409EFF;
}
QMainWindow QPushButton:disabled {
    background-color: #d3d3d3;
    color: #7a7a7a;
    border: 1px solid #bcbcbc;
}